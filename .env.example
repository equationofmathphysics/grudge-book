# Local HTTP is supported only for loopback origins. Public deployment MUST use HTTPS.
PUBLIC_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/grudge.sqlite
ENABLE_AGGREGATE=true
# Optional exact IP of your immediate reverse proxy, as seen by Node's socket.
# Set only if that proxy OVERWRITES X-Real-IP with its verified client address.
# Otherwise all users behind a proxy deliberately share its IP abuse limit.
TRUSTED_PROXY_IP=
