{
  "name": "grudge-book",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server/node.mjs",
    "dev": "NODE_ENV=development node server/node.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs tests/*.test.cjs",
    "db:generate": "drizzle-kit generate",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "npm test && npm run build && npm run verify:build && npm run check:release",
    "check:release": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.4",
    "drizzle-orm": "0.44.5",
    "esbuild": "0.25.10"
  },
  "license": "SEE LICENSE IN LICENSE",
  "description": "A private Chinese-language notebook with optional accounts and mutual-friend statistics."
}
